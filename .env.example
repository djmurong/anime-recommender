# =============================================================================
# Anime Recommender local environment template
# Copy to `.env` and adjust for your machine/cluster.
# =============================================================================

# -----------------------------------------------------------------------------
# SLURM / cluster
# -----------------------------------------------------------------------------
# CPU and GPU partitions visible in `sinfo`
RECSYS_PARTITION_CPU=common
RECSYS_PARTITION_GPU=common

# Slurm account/group (e.g., dataplus, plusds, all-dcc-grads)
RECSYS_SLURM_ACCOUNT=dataplus

# Optional module command run before activating .venv in Slurm jobs
# Example: module load python/3.11
RECSYS_MODULE_PYTHON=

# Optional override for project root on cluster
# RECSYS_ROOT=/work/your_netid/anime-recommender

# -----------------------------------------------------------------------------
# Pipeline controls
# -----------------------------------------------------------------------------
# `full` for real run, `iter` for quick smoke tests
RECSYS_SUBSET=full

# Two-tower training
RECSYS_EPOCHS=10
RECSYS_BATCH_SIZE=2048
RECSYS_USE_BEST_PARAMS=0
RECSYS_NUM_WORKERS=0

# Optuna tuning
RECSYS_TUNE_TRIALS=30
RECSYS_TUNE_MAX_ROWS=2000000

# -----------------------------------------------------------------------------
# Reproducibility
# -----------------------------------------------------------------------------
# Main seed lives in `src/recsys/config.py` (SEED / CFG.seed).
# If you change it, rerun preprocess so splits/maps are regenerated with same seed.

# -----------------------------------------------------------------------------
# Frontend/API placeholders (optional future integration)
# -----------------------------------------------------------------------------
# VITE_USE_MOCK=true
# VITE_API_URL=http://localhost:8000
